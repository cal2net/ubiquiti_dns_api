# API key from https://unifi.ui.com
UNIFI_API_KEY=
# Also accepted: ubiquiti_api_key=

# Local console (LAN). Use the console IP or hostname.
UNIFI_CONSOLE_HOST=192.168.0.1
UNIFI_VERIFY_SSL=false

# Or cloud connector (no VPN). Do not set both host and console id.
# UNIFI_CONSOLE_ID=

# Optional default site UUID from GET /v1/sites
# UNIFI_SITE_ID=
